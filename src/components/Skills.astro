---
import Icon from './Icon.astro';
---

<section class="box skills">
	<div class="stack gap-2 lg:gap-4">
		<Icon icon="terminal-window" color="var(--accent-regular)" size="2.5rem" gradient />
		<h2>Power Platform</h2>
		<p>
			Power Apps, Power Automate, Power BI und SharePoint — vom kleinen Workflow bis zur unter­nehmens­weiten Lösung. PL-600 in Vorbereitung.
		</p>
	</div>
	<div class="stack gap-2 lg:gap-4">
		<Icon icon="strategy" color="var(--accent-regular)" size="2.5rem" gradient />
		<h2>Operations &amp; Prozesse</h2>
		<p>
			Wirtschaftsingenieur FH mit Vertiefung Operations Management. Erfahrung in Lean, Supply Chain, Digital Business Process Engineering und strategischem Einkauf.
		</p>
	</div>
	<div class="stack gap-2 lg:gap-4">
		<Icon icon="code" color="var(--accent-regular)" size="2.5rem" gradient />
		<h2>Eigen­entwicklung</h2>
		<p>
			Low-Code im Beruf, eigener Code in der Freizeit: Web- und Android-Apps mit Next.js, TypeScript und Firebase — von der Datenmodellierung bis zum Deployment.
		</p>
	</div>
</section>

<style>
	.box {
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		padding: 1.5rem;
		background-color: var(--gray-999_40);
		box-shadow: var(--shadow-sm);
	}

	.skills {
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	.skills h2 {
		font-size: var(--text-lg);
	}

	.skills p {
		color: var(--gray-400);
	}

	@media (min-width: 50em) {
		.box {
			border-radius: 1.5rem;
			padding: 2.5rem;
		}

		.skills {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 5rem;
		}

		.skills h2 {
			font-size: var(--text-2xl);
		}
	}
</style>
