---
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Über mich | Janick Blumenstein"
	description="Über Janick Blumenstein — Wirtschaftsingenieur FH, Projektleiter Digitalisierung. Werdegang, Ausbildung und Schwerpunkte."
>
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="Über mich"
				tagline="Vom Konstrukteur über den strategischen Einkauf zum Projektleiter Digitalisierung — wie diese Mischung mein Verständnis für Prozesse geprägt hat."
			>
				<img
					width="1553"
					height="873"
					src="/assets/at-work.jpg"
					alt="Janick Blumenstein bei der Arbeit"
				/>
			</Hero>

			<section>
				<h2 class="section-title">Werdegang</h2>
				<div class="content">
					<p>
						Mein beruflicher Weg begann mit einer Lehre als Konstrukteur EFZ bei der
						<a href="https://www.franke.com/">Franke Schweiz AG</a>, gefolgt von einem einjährigen
						Praktikum als CAD Engineer bei Franke Foodservice Systems in Smyrna, Tennessee. Diese
						frühe Phase hat mir ein solides technisches Fundament gegeben — und mir gezeigt, wie
						unterschiedlich Prozesse in verschiedenen Kulturen funktionieren können.
					</p>
					<p>
						Nach meiner Dienstpflicht in den Schweizer Rettungstruppen kehrte ich zu Franke
						zurück, diesmal als Konstrukteur in Forschung &amp; Entwicklung, später als Buyer im
						strategischen Einkauf. Parallel dazu absolvierte ich an der
						<a href="https://www.hslu.ch/">Hochschule Luzern Technik &amp; Architektur</a> meinen
						Wirtschaftsingenieur FH mit Vertiefung Operations Management. Meine Bachelorarbeit zu
						<em>Digitalization in Strategic Procurement</em> war der Wendepunkt — danach war klar,
						in welche Richtung es weitergeht.
					</p>
					<p>
						Seit Januar 2024 bin ich als Projektleiter Digitalisierung bei der
						<a href="https://www.hunkeler.ch/">Hunkeler AG Paper Processing</a> tätig. Hier baue
						ich Apps für Mitarbeitende und Servicetechniker, automatisiere Geschäftsprozesse und
						übersetze Anforderungen aus Fachabteilungen in funktionierende Lösungen — meistens
						mit Power Apps, Power Automate, SharePoint und Power BI.
					</p>
				</div>
			</section>

			<section>
				<h2 class="section-title">Ausbildung</h2>
				<div class="content">
					<p>
						<strong>Aktuell — Microsoft Power Platform &amp; M365 Administration.</strong>
						Vorbereitung auf die Zertifizierung PL-600 (Power Platform Solution Architect)
						über Microsoft Learn, mit dem Ziel weiterer Zertifizierungen in Power Platform und
						Microsoft 365.
					</p>
					<p>
						<strong>2017 – 2022 — Wirtschaftsingenieur Innovation FH, HSLU Horw.</strong>
						Vertiefung Operations Management mit Schwerpunkten in Digital Business Process
						Engineering, Supply Chain Management, Operational Excellence, Strategischem &amp;
						Produktmanagement und Statistical / Quantitative Data Analysis.
					</p>
					<p>
						<strong>2008 – 2012 — Lehre Konstrukteur EFZ inkl. technischer Berufsmaturität.</strong>
						Berufs- und Weiterbildung Zofingen / Franke Schweiz AG.
					</p>
				</div>
			</section>

			<section>
				<h2 class="section-title">Schwerpunkte</h2>
				<div class="content">
					<p>
						Microsoft Power Platform (Power Apps, Power Automate, Power BI, Dataverse) ·
						Microsoft 365 inkl. SharePoint, Excel/VBA, Teams, M365 Administration ·
						Prozessdigitalisierung &amp; Low-Code-Entwicklung · Datenmodellierung, Reporting
						und Schnittstellenintegration · Strategischer Einkauf &amp; Lieferantenmanagement ·
						Operational Excellence / Lean · Projektmanagement von Konzeption bis Rollout.
					</p>
					<p>
						ERP-Systeme: SAP FOX, ProAlpha, IFS, ECTR. Weitere Tools: Adobe Suite (ID, AI, PS),
						CAD (diverse Systeme), QlikSense.
					</p>
					<p>
						Sprachen: Deutsch (Muttersprache), Englisch (verhandlungssicher), Französisch
						(mündlich &amp; schriftlich), Italienisch (Grundkenntnisse).
					</p>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}
</style>
