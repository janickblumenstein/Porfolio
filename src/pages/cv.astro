		<style is:global>
			:root {
				color-scheme: light;
			}
			*, *::before, *::after { box-sizing: border-box; }
			html { -webkit-text-size-adjust: 100%; }
			body {
				margin: 0;
				font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Helvetica, Arial,
					sans-serif;
				font-size: 11pt;
				line-height: 1.5;
				color: #111;
				background: #f4f4f2;
				padding: 32px 16px;
			}

			.page {
				max-width: 800px;
				margin: 0 auto;
				background: #fff;
				padding: 56px 64px;
				box-shadow: 0 8px 40px rgba(0, 0, 0, 0.06);
			}

			.toolbar {
				max-width: 800px;
				margin: 0 auto 16px;
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 12px;
				font-size: 12px;
				color: #666;
			}
			.toolbar a, .toolbar button {
				display: inline-flex;
				align-items: center;
				gap: 6px;
				font-family: inherit;
				font-size: 12px;
				padding: 8px 14px;
				border: 1px solid #ccc;
				border-radius: 999px;
				background: #fff;
				color: #111;
				cursor: pointer;
				text-decoration: none;
				transition: background 0.15s ease;
			}
			.toolbar a:hover, .toolbar button:hover { background: #f4f4f2; }

			header.cv-head {
				border-bottom: 2px solid #111;
				padding-bottom: 18px;
				margin-bottom: 24px;
			}
			h1 {
				font-size: 26pt;
				font-weight: 700;
				letter-spacing: -0.01em;
				margin: 0 0 4px;
				color: #111;
			}
			.role {
				font-size: 13pt;
				color: #444;
				margin: 0 0 14px;
				font-weight: 500;
			}
			.contact-line {
				font-size: 10.5pt;
				color: #444;
				margin: 0;
			}
			.contact-line a { color: #444; text-decoration: none; }
			.contact-line a:hover { text-decoration: underline; }
			.contact-line .sep { margin: 0 8px; color: #aaa; }

			h2.section-title {
				font-size: 11pt;
				font-weight: 700;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				margin: 28px 0 12px;
				padding-bottom: 4px;
				border-bottom: 1px solid #ccc;
				color: #111;
			}

			.summary { margin: 0 0 8px; font-size: 11pt; line-height: 1.55; }

			.entry { margin-bottom: 16px; page-break-inside: avoid; }
			.entry-head {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 12px;
				flex-wrap: wrap;
			}
			.entry-title { font-size: 11.5pt; font-weight: 700; margin: 0; color: #111; }
			.entry-date { font-size: 10pt; color: #666; white-space: nowrap; }
			.entry-org { font-size: 10.5pt; color: #444; margin: 2px 0 6px; font-style: italic; }
			.entry ul { margin: 4px 0 0; padding-left: 18px; }
			.entry li { font-size: 10.5pt; line-height: 1.5; margin-bottom: 2px; }

			.skill-group { margin-bottom: 8px; font-size: 10.5pt; }
			.skill-group strong { display: inline-block; min-width: 160px; color: #111; }

			.langs {
				list-style: none;
				padding: 0;
				margin: 0;
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
				gap: 4px 24px;
				font-size: 10.5pt;
			}
			.langs li strong { display: inline-block; min-width: 110px; }

			.meta-line {
				margin-top: 4px;
				font-size: 10pt;
				color: #666;
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
				gap: 6px 24px;
			}
			.meta-line strong { color: #111; }

			@page { size: A4; margin: 14mm 16mm; }

			@media print {
				body { background: #fff; padding: 0; font-size: 10.5pt; }
				.toolbar { display: none; }
				.page { max-width: none; margin: 0; padding: 0; box-shadow: none; }
				h1 { font-size: 22pt; }
				.role { font-size: 12pt; }
				h2.section-title { margin-top: 18px; }
				.entry { margin-bottom: 12px; }
				a { color: inherit; text-decoration: none; }
			}
		</style>

		<script>
			document.getElementById('printBtn')!.addEventListener('click', () => window.print());
			if (new URLSearchParams(location.search).get('print') === '1') {
				window.addEventListener('load', () => setTimeout(() => window.print(), 400));
			}
		</script>
	</body>
</html>
