---
import { getCollection } from 'astro:content';

// Components
import CallToAction from '../components/CallToAction.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Pill from '../components/Pill.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import Showcase from '../components/Showcase.astro';
import Skills from '../components/Skills.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

// Single source of truth
import { personal, tagline, experience, meta } from '../data/cv';

// Content Collection — most recent 4 work projects
const projects = (await getCollection('work'))
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
	.slice(0, 4);

// Top 5 stations (from cv.ts) for the "Stationen" section
const stations = experience.slice(0, 5);

// Showcase scenes — leave `media` empty to render the placeholder.
// Once you have screenshots/GIFs/videos, drop them in /public/assets/showcases/
// and fill in the `media` + `mediaType` fields.
const showcaseScenes = [
	{
		title: 'Apps unterwegs',
		description:
			'Servicetechniker dokumentieren Einsätze direkt beim Kunden — mobil. Was früher abends im Büro getippt wurde, ist jetzt vor Ort fertig.',
		media: '/assets/showcases/PZE.png', // z.B. '/assets/showcases/service-app.mp4'
		mediaType: 'image' as const,
		alt: 'Service-Techniker-App auf Smartphone',
		dimensions: '750 × 1624 px (Mobile)',
		format: 'WebM oder MP4 · Loop ohne Ton',
	},
	{
		title: 'Workflows ohne Mailflut',
		description:
			'Anträge, Genehmigungen und Reminder laufen automatisiert via Power Automate. Statt verlorenen E-Mail-Threads gibt es einen klaren Status — für die Antragsteller, die Vorgesetzten und das HR-Team.',
		media: '',
		mediaType: 'image' as const,
		alt: 'Power Automate Flow Designer',
		dimensions: '1280 × 800 px',
		format: 'PNG oder WebP',
	},
	{
		title: 'Daten in Bewegung',
		description:
			'Dashboards in Power BI, die nicht nur Zahlen zeigen, sondern Entscheidungen vereinfachen. Live-Daten aus SAP, SharePoint und Dataverse, in einer Oberfläche zusammengeführt.',
		media: '',
		mediaType: 'image' as const,
		alt: 'Power BI Dashboard',
		dimensions: '1280 × 800 px',
		format: 'PNG oder WebP',
	},
];
---

<BaseLayout
	title={`${personal.fullName} — Digitalisierung & Operations`}
	description={tagline}
>
	<div class="stack gap-20 lg:gap-48">
		<div class="wrapper stack gap-8 lg:gap-20">
			<header class="hero">
				<Hero
					title={`Hallo, ich bin ${personal.firstName} ${personal.lastName}`}
					tagline={tagline}
					align="start"
				>
					<div class="roles">
						<Pill><Icon icon="code" size="1.33em" /> Power Platform</Pill>
						<Pill><Icon icon="strategy" size="1.33em" /> Operations</Pill>
						<Pill><Icon icon="trophy" size="1.33em" /> Digitalisierung</Pill>
					</div>
					<p class="status">
						<span class="status-dot" aria-hidden="true"></span>
						{meta.availabilityShort}
					</p>
				</Hero>

				<img
					alt={`${personal.fullName}, Portraitfoto`}
					width="480"
					height="620"
					src="/assets/portrait.jpg"
				/>
			</header>

			<Skills />
		</div>

		<main class="wrapper stack gap-20 lg:gap-48">
			{/* ─────────  SHOWCASE — sticky cross-fade with screenshots/videos  ───────── */}
			<Showcase
				title="Live aus der Praxis"
				intro="Drei Beispiele aus dem Alltag — die echten Apps, Workflows und Dashboards folgen als Screenshots, GIFs und Videos."
				scenes={showcaseScenes}
				aspectRatio="9 / 16"
			/>

			{/* ─────────  AUSGEWÄHLTE PROJEKTE  ───────── */}
			<section class="section with-background with-cta">
				<header class="section-header stack gap-2 lg:gap-4">
					<h3>Ausgewählte Projekte</h3>
					<p>
						Eine Auswahl meiner Digitalisierungsprojekte aus den letzten Jahren — von Mitarbeiter-Apps
						über automatisierte Workflows bis zu Reporting-Lösungen.
					</p>
				</header>

				<div class="gallery">
					<Grid variant="offset">
						{
							projects.map((project) => (
								<li>
									<PortfolioPreview project={project} />
								</li>
							))
						}
					</Grid>
				</div>

				<div class="cta">
					<CallToAction href="/work/">
						Alle Projekte
						<Icon icon="arrow-right" size="1.2em" />
					</CallToAction>
				</div>
			</section>

			{/* ─────────  STATIONEN  ───────── */}
			<section class="section with-background bg-variant">
				<header class="section-header stack gap-2 lg:gap-4">
					<h3>Stationen</h3>
					<p>
						Mein Weg führte vom Konstrukteur über den strategischen Einkauf bis zum heutigen
						Projektleiter Digitalisierung.
					</p>
				</header>

				<div class="gallery">
					<Grid variant="small">
						{
							stations.map((station) => (
								<li class="mention-card">
									<p>
										<strong>{station.organization}</strong>
										<br />
										<span>{station.role}</span>
									</p>
								</li>
							))
						}
					</Grid>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
	}

	.roles {
		display: none;
	}

	.hero img {
		aspect-ratio: 5 / 4;
		object-fit: cover;
		object-position: top;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	/* Status pill below the tagline */
	.status {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-mono, ui-monospace, monospace);
		font-size: var(--text-sm);
		color: var(--gray-300);
		margin-top: 1rem;
		padding: 0.4rem 0.8rem;
		border: 1px solid var(--gray-800);
		border-radius: 999px;
		width: fit-content;
	}
	.status-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #2f8f4e;
		box-shadow: 0 0 0 0 rgba(47, 143, 78, 0.55);
		animation: pulse-green 2.6s cubic-bezier(0.2, 0.7, 0.2, 1) infinite;
	}
	@keyframes pulse-green {
		0% {
			box-shadow: 0 0 0 0 rgba(47, 143, 78, 0.55);
		}
		70% {
			box-shadow: 0 0 0 8px rgba(47, 143, 78, 0);
		}
		100% {
			box-shadow: 0 0 0 0 rgba(47, 143, 78, 0);
		}
	}

	@media (min-width: 50em) {
		.hero {
			display: grid;
			grid-template-columns: 6fr 4fr;
			padding-inline: 2.5rem;
			gap: 3.75rem;
		}

		.roles {
			margin-top: 0.5rem;
			display: flex;
			gap: 0.5rem;
		}

		.hero img {
			aspect-ratio: 3 / 4;
			border-radius: 4.5rem;
			object-fit: cover;
		}
	}

	/* ====================================================== */

	.section {
		display: grid;
		gap: 2rem;
	}

	.with-background {
		position: relative;
	}

	.with-background::before {
		--hero-bg: var(--bg-image-subtle-2);

		content: '';
		position: absolute;
		pointer-events: none;
		left: 50%;
		width: 100vw;
		aspect-ratio: calc(2.25 / var(--bg-scale));
		top: 0;
		transform: translateY(-75%) translateX(-50%);
		background:
			url('/assets/backgrounds/noise.png') top center/220px repeat,
			var(--hero-bg) center center / var(--bg-gradient-size) no-repeat,
			var(--gray-999);
		background-blend-mode: overlay, normal, normal, normal;
		mix-blend-mode: var(--bg-blend-mode);
		z-index: -1;
	}

	.with-background.bg-variant::before {
		--hero-bg: var(--bg-image-subtle-1);
	}

	.section-header {
		justify-self: center;
		text-align: center;
		max-width: 50ch;
		font-size: var(--text-md);
		color: var(--gray-300);
	}

	.section-header h3 {
		font-size: var(--text-2xl);
	}

	@media (min-width: 50em) {
		.section {
			grid-template-columns: repeat(4, 1fr);
			grid-template-areas: 'header header header header' 'gallery gallery gallery gallery';
			gap: 5rem;
		}

		.section.with-cta {
			grid-template-areas: 'header header header cta' 'gallery gallery gallery gallery';
		}

		.section-header {
			grid-area: header;
			font-size: var(--text-lg);
		}

		.section-header h3 {
			font-size: var(--text-4xl);
		}

		.with-cta .section-header {
			justify-self: flex-start;
			text-align: left;
		}

		.gallery {
			grid-area: gallery;
		}

		.cta {
			grid-area: cta;
		}
	}

	/* ====================================================== */

	.mention-card {
		display: flex;
		height: 7rem;
		justify-content: center;
		align-items: center;
		text-align: center;
		border: 1px solid var(--gray-800);
		border-radius: 1.5rem;
		color: var(--gray-300);
		background: var(--gradient-subtle);
		box-shadow: var(--shadow-sm);
		padding: 1rem;
	}
	.mention-card strong {
		color: var(--gray-100);
		font-weight: 500;
	}

	@media (min-width: 50em) {
		.mention-card {
			border-radius: 1.5rem;
			height: 9.5rem;
		}
	}
</style>
